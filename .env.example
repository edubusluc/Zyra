# Copia este fichero como .env (junto a manage.py) y rellena los valores.
# El .env nunca se sube a git.

# --- En tu ordenador ---------------------------------------------------------
# Modo desarrollo: muestra los errores con detalle y sirve los ficheros estáticos.
# Con DJANGO_DEBUG=True las claves de abajo son opcionales.
DJANGO_DEBUG=True

# --- En producción (DJANGO_DEBUG=False o sin definir) ------------------------
# Obligatoria, mínimo 50 caracteres. Genérala con:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=
# Obligatoria. Cifra las cuentas SNP de los clubes; si la cambias, hay que volver a
# introducirlas. Genérala con:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=
# Dominios de la web, separados por comas.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Orígenes https de confianza para los formularios (p. ej. https://tu-dominio).
DJANGO_CSRF_TRUSTED_ORIGINS=
# URL pública única de la web, sin barra final (https://tu-dominio). Las URLs canónicas, la
# vista previa al compartir y el sitemap la usan, y cualquier otro dominio de
# DJANGO_ALLOWED_HOSTS (p. ej. www.tu-dominio) redirige aquí con un 301. Vacía en local.
# También la necesita send_monthly_reports para el enlace de baja de los correos mensuales.
SITE_URL=
# Datos del responsable para el aviso legal y la política de privacidad (LSSI-CE y RGPD).
LEGAL_OWNER_NAME=
LEGAL_OWNER_ID=
LEGAL_OWNER_ADDRESS=
# Correo de contacto del pie y de las páginas legales (por defecto join.zyra@gmail.com).
# CONTACT_EMAIL=
# Pon True si el hosting tiene delante un proxy que termina el https.
DJANGO_BEHIND_PROXY=False
# Redirección a https (True en producción salvo que lo haga el proxy).
DJANGO_SECURE_SSL_REDIRECT=True
# HSTS en segundos: empieza con 3600 y súbelo a 31536000 cuando todo vaya por https.
DJANGO_SECURE_HSTS_SECONDS=3600

# --- Base de datos ------------------------------------------------------------
# Sin DATABASE_URL se usa SQLite (db.sqlite3). En producción, PostgreSQL:
# DATABASE_URL=postgres://usuario:contraseña@servidor:5432/zyra
DATABASE_URL=
# Segundos que se reutiliza cada conexión (0 = abrir una por petición).
DATABASE_CONN_MAX_AGE=60

# --- Fotos subidas (escudos y fotos de jugador) ------------------------------
# Carpeta donde se guardan (por defecto media/ junto a manage.py). En el servidor, una
# carpeta de un disco persistente que el servidor web sirve en /media/.
# DJANGO_MEDIA_ROOT=/srv/zyra/media
# Para guardarlas en un bucket compatible con S3 (Hetzner Object Storage, R2...):
# pip install "django-storages[s3]" y rellena estas variables.
# DJANGO_MEDIA_STORAGE=storages.backends.s3.S3Storage
# AWS_STORAGE_BUCKET_NAME=
# AWS_S3_ENDPOINT_URL=
# AWS_S3_REGION_NAME=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_CUSTOM_DOMAIN=
# Tamaño máximo de la foto subida (MB), lado máximo tras reducirla (px) y calidad WebP.
# PHOTO_MAX_UPLOAD_MB=10
# PHOTO_MAX_SIZE=512
# PHOTO_WEBP_QUALITY=82

# --- Seguridad y proxy --------------------------------------------------------
# Obligatoria en producción: ruta del Django admin (no puede ser admin/). Termina en /.
# ADMIN_URL=gestion-larga-y-secreta/
# Proxies de confianza delante de la app (para la IP real en los frenos de abuso).
# DJANGO_TRUSTED_PROXY_COUNT=1
# En producción: python manage.py createcachetable (caché compartida de los frenos).

# --- Logs y errores -----------------------------------------------------------
DJANGO_LOG_LEVEL=INFO
# Opcional: DSN de Sentry para recibir los errores agrupados.
SENTRY_DSN=

# --- Correo (informes de convocatoria) ---------------------------------------
# Remitente técnico de la plataforma (por defecto join.zyra@gmail.com). Con dominio propio y Brevo:
# ZYRA_SENDER=convocatoria@tu-dominio, EMAIL_HOST=smtp-relay.brevo.com, EMAIL_HOST_USER=<login SMTP>
# ZYRA_SENDER=
EMAIL_HOST_PASSWORD=
# Correos como mucho en cada pasada de send_call_reports (cada 5 minutos).
# EMAIL_MAX_PER_RUN=100

# --- Puntos SNP (update_snp_scores) -------------------------------------------
# Clubes por lote, pausa aleatoria entre clubes y entre lotes (segundos) y fallos
# de red seguidos que hacen parar el proceso.
# SNP_BATCH_SIZE=50
# SNP_PAUSE_MIN_SECONDS=5
# SNP_PAUSE_MAX_SECONDS=15
# SNP_BATCH_PAUSE_SECONDS=60
# SNP_MAX_CONSECUTIVE_FAILURES=5

# --- Inicio de sesión con Google (opcional) -----------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
